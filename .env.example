# Copy to .env and adjust (gitignored). Spring Boot loads repo-root .env when you run from backend/.
# cp .env.example .env

# --- Database (optional; defaults match docker-compose) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=garagebrain
# DB_USER=garagebrain
# DB_PASSWORD=garagebrain
# If port 5432 is taken: DB_PORT=5433 and restart compose (maps host 5433 → container 5432)

# --- BYOM / local LLM (optional) ---

# Ollama (default when no .env)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# LM Studio / other OpenAI-compatible local server
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:1234
# LLM_MODEL=your-model-id
# LLM_API_KEY=lm-studio

# Parquet archive + import staging (optional)
# GARAGEBRAIN_DATA_DIR=~/.garage-brain
